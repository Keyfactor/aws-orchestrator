<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
	  <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Keyfactor.Extensions.Orchestrator.Aws.Acm</RootNamespace>
    <AssemblyName>Keyfactor.Extensions.Orchestrator.Aws.Acm</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CertificateManager" Version="4.0.102.10" />
    <PackageReference Include="AWSSDK.EC2" Version="4.0.127" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.11" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="4.0.103.10" />
    <PackageReference Include="AWSSDK.Organizations" Version="4.0.103" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.4" />
    <PackageReference Include="Keyfactor.Extensions.Aws.Auth" Version="0.5.2" />
    <PackageReference Include="Keyfactor.Logging" Version="1.3.0" />
    <PackageReference Include="Keyfactor.Orchestrators.IOrchestratorJobExtensions" Version="1.0.0" />
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />

    <None Update="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
